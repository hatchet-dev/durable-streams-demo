{
  "name": "durablestreamsdemo",
  "private": true,
  "version": "0.0.0",
  "description": "Chatbot demo of Hatchet durable streams: a worker publishes Claude's reply to a topic, and a small backend relays the topic to the browser",
  "type": "module",
  "scripts": {
    "worker": "tsx --env-file=.env worker/worker.ts",
    "backend": "tsx --env-file=.env server/server.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hatchet-dev/typescript-sdk": "^1.46.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
